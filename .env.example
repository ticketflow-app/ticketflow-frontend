# API Gateway used by the Next.js BFF (server-side only)
API_GATEWAY_URL=http://localhost:8080

# httpOnly cookie that stores the JWT (BFF pattern)
AUTH_COOKIE_NAME=tf_token

# Enable MSW mocks for endpoints the backend does not expose yet
NEXT_PUBLIC_API_MOCKING=enabled

# Optional absolute origin for the BFF calls (leave empty in the browser)
NEXT_PUBLIC_API_BASE_URL=
